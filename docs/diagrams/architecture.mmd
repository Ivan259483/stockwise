flowchart TB
    subgraph CLIENT["Presentation tier · React SPA on Vercel static hosting (stockwise-ivan)"]
        direction LR
        U(["Santos Family Hardware<br/>owners (admin) and staff<br/>desktop or phone browser"])
        C["<b>React + Vite</b><br/>Dashboard · Products · Stock · <b>Purchase Orders</b><br/>Users · <b>Archive</b> · <b>Profile</b> · Password recovery<br/>AuthContext keeps the JWT; Axios sends it"]
        U --> C
    end

    subgraph API["Application tier · Express REST API on Vercel serverless functions (stockwise-api-ivan)"]
        direction LR
        M["<b>1. Middleware</b><br/>helmet · cors · json<br/>morgan · rate limits"]
        A["<b>2. Authentication</b><br/>protect: JWT + token version<br/>authorize: admin / staff"]
        R["<b>3. Validate + controller</b><br/>auth · users · products<br/>stock · <b>purchase orders</b> · <b>archive</b>"]
        S["<b>4. Services</b><br/>stockService (atomic $inc)<br/><b>stockAlerts</b> · <b>mailer</b>"]
        E["<b>5. Error handler</b><br/>one JSON error shape"]
        M --> A --> R --> S
        R -.-> E
    end

    subgraph DATA["Data tier · MongoDB Atlas"]
        direction LR
        D[("<b>stockwise</b> database<br/>users · categories · suppliers · products<br/>stockmovements · <b>purchaseorders</b> · counters<br/>archive fields on 4 collections")]
    end

    subgraph EXT["External service"]
        direction LR
        G["<b>Gmail SMTP</b> (smtp.gmail.com:465)<br/>password-reset codes<br/>low-stock alerts to admins"]
    end

    CLIENT -- "HTTPS + JSON (REST)<br/>Authorization: Bearer JWT" --> API
    API -- "Mongoose ODM<br/>(cached connection)" --> DATA
    S -- "Nodemailer over TLS<br/>(App password from env)" --> G
