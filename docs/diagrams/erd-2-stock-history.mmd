erDiagram
    direction LR
    USER ||--o{ STOCK_MOVEMENT : "performs"
    PRODUCT ||--o{ STOCK_MOVEMENT : "has history"
    PURCHASE_ORDER |o--o{ STOCK_MOVEMENT : "creates on receipt"

    USER {
        ObjectId _id PK
        String name
        String email UK
        String password
        String role
        Boolean isActive
        Number tokenVersion
        String resetCodeHash
        Date resetCodeExpires
        Boolean archived
        Date archivedAt
        ObjectId archivedBy FK
        String archiveReason
    }
    PRODUCT {
        ObjectId _id PK
        String sku UK
        String name
    }
    PURCHASE_ORDER {
        ObjectId _id PK
        String poNumber UK
    }
    STOCK_MOVEMENT {
        ObjectId _id PK
        ObjectId product FK
        String productName
        String sku
        String type
        Number quantity
        Number previousQty
        Number newQty
        String reason
        ObjectId performedBy FK
        ObjectId purchaseOrder FK
        String poNumber
    }
