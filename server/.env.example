# MongoDB Atlas connection string (database name: stockwise)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/stockwise?retryWrites=true&w=majority

# Secret used to sign JWTs. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1d

# Comma-separated list of origins allowed by CORS
CLIENT_URL=http://localhost:5173,https://your-client.vercel.app

# Local port (5050 because macOS AirPlay Receiver uses 5000)
PORT=5050
NODE_ENV=development

# Gmail SMTP for password-reset codes and low-stock alerts.
# SMTP_USER: the Gmail address that sends the emails.
# SMTP_PASS: a 16-character Google "App password" (Google Account → Security →
#            2-Step Verification → App passwords), NOT your normal Gmail password.
# If these are empty, no email is sent; in development the message (and the
# reset code) is printed in the backend console instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=Santos Family Hardware (StockWise)

# Optional: extra addresses (comma-separated) that also receive low-stock alerts.
# The demo admins use a made-up domain, so put your own email here to see the alerts.
STOCK_ALERT_CC=
# Optional: web app address used in alert links (defaults to the https CLIENT_URL entry).
APP_URL=
