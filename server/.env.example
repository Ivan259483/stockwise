# MongoDB Atlas connection string (database name: stockwise)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/stockwise?retryWrites=true&w=majority

# Secret used to sign JWTs. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1d

# Comma-separated list of origins allowed by CORS
CLIENT_URL=http://localhost:5173,https://your-client.vercel.app

# Local port (5050 because macOS AirPlay Receiver uses 5000)
PORT=5050
NODE_ENV=development
