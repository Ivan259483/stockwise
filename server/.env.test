# Environment for the automated tests (npm run dev:test / seed:test / smoke).
# Committed on purpose: it contains no secrets and points only at a local
# throwaway database. Tests refuse to run unless the database name ends in _test.
MONGO_URI=mongodb://127.0.0.1:27017/stockwise_test
JWT_SECRET=test-only-secret-not-used-anywhere-else-0123456789abcdef
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5174
PORT=5051
# NODE_ENV=test writes emails to tmp/outbox.jsonl instead of sending them.
NODE_ENV=test
# Empty on purpose so values from .env are never used by the test server.
SMTP_USER=
SMTP_PASS=
STOCK_ALERT_CC=
# Higher limit so repeated test runs are not blocked by the per-IP limiter.
RESET_RATE_LIMIT=200
